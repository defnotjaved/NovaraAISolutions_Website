---
interface Props {
  /** CSS color the wave fills into (the NEXT section's background) */
  fill?: string;
  flip?: boolean;
}
const { fill = 'var(--ink-950)', flip = false } = Astro.props;
---

<div class:list={['wave', { flip }]} aria-hidden="true">
  <svg viewBox="0 0 1440 90" preserveAspectRatio="none">
    <path d="M0 45C240 90 480 0 720 25s480 65 720 20v45H0Z" fill={fill} />
  </svg>
</div>

<style>
  .wave {
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    z-index: 1;
    line-height: 0;
    pointer-events: none;
  }
  .wave.flip { transform: scaleX(-1); }
  .wave svg { width: 100%; height: 70px; }
</style>
