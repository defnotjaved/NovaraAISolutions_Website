---
import { PRODUCTS } from '../../data/products';
---

<section class="const-sec section" id="constellation" aria-label="The Novara product stack">
  <div class="container head" data-reveal>
    <span class="kicker">The archipelago</span>
    <h2>One team. <span class="grad-text">A whole stack.</span></h2>
    <p class="lead">
      Everything below is real, running software we built — not slideware. Each one started as a
      problem someone here actually had.
    </p>
  </div>

  <div class="container grid" data-const-grid>
    <svg class="const-lines" aria-hidden="true" data-const-lines>
      <!-- constellation lines drawn by homeScroll.ts -->
    </svg>
    {PRODUCTS.map((p, i) => (
      <article
        class:list={['card glass-card', `accent-${p.accent}`]}
        data-reveal
        style={`--reveal-delay:${(i % 4) * 90}ms`}
        id={p.id}
      >
        <div class="card-top">
          <span class="dot" aria-hidden="true"></span>
          <span class:list={['chip', { live: p.status === 'LIVE' }]}>{p.status}</span>
        </div>
        <h3>{p.name}</h3>
        <p class="strap mono">{p.strap}</p>
        <p class="blurb">{p.blurb}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .const-sec { background: var(--ink-950); overflow: hidden; }
  .head { max-width: 44rem; margin-bottom: 3rem; }

  .grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.1rem;
  }
  .const-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    color: rgba(96, 165, 250, 0.18);
  }

  .card {
    position: relative;
    z-index: 1;
    padding: 1.4rem 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .card:hover {
    transform: translateY(-5px);
    border-color: var(--glass-border-bright);
    box-shadow: var(--shadow-card);
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }
  .dot { width: 9px; height: 9px; border-radius: 50%; }
  .accent-blue .dot { background: var(--icon-blue); box-shadow: 0 0 10px var(--icon-blue); }
  .accent-teal .dot { background: var(--teal-400); box-shadow: 0 0 10px var(--teal-400); }
  .accent-gold .dot { background: var(--gold-400); box-shadow: 0 0 10px var(--gold-400); }
  .accent-violet .dot { background: #9b5cff; box-shadow: 0 0 10px #9b5cff; }
  .card h3 { font-size: 1.15rem; }
  .strap {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-400);
  }
  .blurb { font-size: 0.88rem; color: var(--text-300); }
</style>
